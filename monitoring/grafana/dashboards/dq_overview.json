        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Failing checks in the latest run (with sample bad row IDs)",
      "datasource": {
        "type": "postgres",
        "uid": "warehouse-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "warehouse-pg"
          },
          "rawSql": "SELECT table_name AS \"Table\", severity AS \"Severity\", dimension AS \"Dimension\", check_name AS \"Check\",\n       unexpected_count AS \"Bad rows\", ROUND(unexpected_percent::numeric, 2) AS \"Bad %\", observed_value AS \"Observed\",\n       bad_row_ids AS \"Sample bad IDs\", executed_at AS \"Executed\"\nFROM dq.dq_check_results\nWHERE success = false\n  AND run_id = (SELECT run_id FROM dq.dq_check_results ORDER BY executed_at DESC LIMIT 1)\nORDER BY CASE severity WHEN 'critical' THEN 0 ELSE 1 END, table_name, check_name",
          "format": "table",
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Severity"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "critical": {
                        "color": "red",
                        "text": "critical"
                      },
                      "warning": {
                        "color": "orange",
                        "text": "warning"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Pass-rate history per DAG run",
      "datasource": {
        "type": "postgres",
        "uid": "warehouse-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "warehouse-pg"
          },
          "rawSql": "SELECT finished_at AS time, pass_rate * 100 AS \"pass rate %\", critical_failed AS \"critical failures\"\nFROM dq.dq_run_summary WHERE $__timeFilter(finished_at) ORDER BY 1",
          "format": "time_series",
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
